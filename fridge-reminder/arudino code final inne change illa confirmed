void sendNearbyNetworks() {
  int networkCount = WiFi.scanNetworks();
  DynamicJsonDocument response(3072);
  JsonArray networks = response.createNestedArray("networks");
  if (networkCount > 0) {
    for (int index = 0; index < networkCount; index++) {
      String ssid = WiFi.SSID(index);
      if (ssid.length() == 0) continue;
      JsonObject network = networks.createNestedObject();
      network["ssid"] = ssid;
      network["rssi"] = WiFi.RSSI(index);
      network["secured"] = WiFi.encryptionType(index) != ENC_TYPE_NONE;
    }
  }
  WiFi.scanDelete();
  String payload;
  serializeJson(response, payload);
  configServer.sendHeader("Cache-Control", "no-store");
  configServer.send(200, "application/json", payload);
}
void startConfigPortal() {
  WiFi.disconnect();
  delay(100);
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(CONFIG_AP_NAME); // Open network: anyone nearby can complete setup.
  dnsServer.start(DNS_PORT, "*", WiFi.softAPIP());
  configServer.on("/save", HTTP_POST, []() {
    String ssid = configServer.arg("ssid");
    String password = configServer.arg("password");
    String apiEndpoint = configServer.arg("apiEndpoint");
    if (ssid.length() == 0 || !apiEndpoint.startsWith("http://")) {
      configServer.send(400, "text/plain", "Wi-Fi name and an http:// API address are required.");
      return;
    }
    saveConfig(ssid, password, apiEndpoint);
    configServer.send(200, "text/html", "<h2>Saved</h2><p>The Smart Fridge is restarting and connecting to Wi-Fi.</p>");
    delay(1200);
    ESP.restart();
  });
  configServer.on("/networks", HTTP_GET, sendNearbyNetworks);
  configServer.onNotFound(showPortalPage); // Captive-portal probes and all URLs show setup.
  configServer.begin();
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 14);
  display.print("Wi-Fi setup mode");
  display.setCursor(0, 30);
  display.print("Connect to:");
  display.setCursor(0, 42);
  display.print(CONFIG_AP_NAME);
  display.setCursor(0, 54);
  display.print("Then open any website");
  display.display();
  while (true) {
    dnsServer.processNextRequest();
    configServer.handleClient();
    delay(2);
  }
}
bool connectWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.begin(deviceConfig.wifiSsid, deviceConfig.wifiPassword);
  unsigned long startedAt = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - startedAt < 20000) {
    delay(300);
  }
  return WiFi.status() == WL_CONNECTED;
}
float batteryVoltage() {
  uint32_t totalReading = 0;
  constexpr uint8_t SAMPLE_COUNT = 8;
  for (uint8_t sample = 0; sample < SAMPLE_COUNT; sample++) {
    totalReading += analogRead(A0);
  }
  float averageReading = totalReading / static_cast<float>(SAMPLE_COUNT);
  float a0Voltage = averageReading * (NODEMCU_A0_FULL_SCALE_VOLTAGE / 1023.0F);
  return a0Voltage * BATTERY_DIVIDER_RATIO;
}
int batteryPercent() {
  const float voltage = batteryVoltage();
  const float curve[][2] = {
    {4.20F, 100.0F}, {4.10F, 90.0F}, {4.00F, 75.0F}, {3.90F, 55.0F},
    {3.80F, 35.0F}, {3.70F, 15.0F}, {3.50F, 5.0F}, {3.20F, 0.0F},
  };
  if (voltage >= curve[0][0]) return 100;
  for (uint8_t point = 1; point < sizeof(curve) / sizeof(curve[0]); point++) {
    if (voltage >= curve[point][0]) {
      float upperVoltage = curve[point - 1][0];
      float upperPercent = curve[point - 1][1];
      float lowerVoltage = curve[point][0];
      float lowerPercent = curve[point][1];
      float percent = lowerPercent + (voltage - lowerVoltage) * (upperPercent - lowerPercent) /
                                           (upperVoltage - lowerVoltage);
      return constrain(round(percent), 0, 100);
    }
  }
  return 0;
}
time_t expiryTime(const String& dateText) {
  int year, month, day;
  if (sscanf(dateText.c_str(), "%d-%d-%d", &year, &month, &day) != 3) return 0;
  tm expiry = {};
  expiry.tm_year = year - 1900;
  expiry.tm_mon = month - 1;
  expiry.tm_mday = day;
  expiry.tm_hour = 12;  // Avoid daylight-saving/date-boundary problems.
  return mktime(&expiry);
}
int daysUntilExpiry(const FridgeItem& item) {
  time_t expiry = expiryTime(item.expiryDate);
  if (expiry == 0) return 9999;
  time_t now = time(nullptr);
  return floor(difftime(expiry, now) / 86400.0F);
}
// Dates are YYYY-MM-DD, so lexical order is chronological order. Products
// without a date stay at the end of the list.
bool expiresBefore(const FridgeItem& left, const FridgeItem& right) {
  if (left.expiryDate.length() == 0) return false;
  if (right.expiryDate.length() == 0) return true;
  return left.expiryDate < right.expiryDate;
}
void sortItemsByExpiryDate() {
  for (uint8_t i = 0; i + 1 < itemCount; i++) {
    for (uint8_t j = 0; j + 1 < itemCount - i; j++) {
      if (expiresBefore(items[j + 1], items[j])) {
        FridgeItem temporary = items[j];
        items[j] = items[j + 1];
        items[j + 1] = temporary;
      }
    }
  }
}
String apiPath(const String& path) {
  String endpoint = deviceConfig.apiEndpoint;
  if (endpoint.endsWith("/") && path.startsWith("/")) return endpoint + path.substring(1);
  if (!endpoint.endsWith("/") && !path.startsWith("/")) return endpoint + "/" + path;
  return endpoint + path;
}
void removeLocalItem(uint8_t itemIndex) {
  if (itemIndex >= itemCount) return;
  for (uint8_t i = itemIndex; i + 1 < itemCount; i++) {
    items[i] = items[i + 1];
  }
  itemCount--;
  if (selectedItem >= itemCount) selectedItem = 0;
}
bool deleteSelectedItem() {
  if (itemCount == 0 || selectedItem >= itemCount) return false;
  const String id = items[selectedItem].id;
  if (id.length() == 0) {
    lastSyncFailed = true;
    lastSyncStatus = "Missing item id";
    return false;
  }
  if (WiFi.status() != WL_CONNECTED && !connectWiFi()) {
    lastSyncFailed = true;
    lastSyncStatus = "Wi-Fi not connected";
    return false;
  }

  WiFiClient client;
  HTTPClient http;
  http.setTimeout(8000);
  if (!http.begin(client, apiPath("/items/" + id))) {
    lastSyncFailed = true;
    lastSyncStatus = "Invalid API address";
    return false;
  }

  int httpCode = http.sendRequest("DELETE");
  http.end();
  if (httpCode != HTTP_CODE_OK) {
    lastSyncFailed = true;
    lastSyncStatus = "Delete error " + String(httpCode);
    return false;
  }

  removeLocalItem(selectedItem);
  lastSyncFailed = false;
  lastSyncStatus = "Deleted product";
  lastFetch = millis();
  return true;
}
// 2 = expired, 1 = expiring within three days, 0 = normal
uint8_t highestAlertLevel() {
  uint8_t level = 0;
  for (uint8_t i = 0; i < itemCount; i++) {
    int days = daysUntilExpiry(items[i]);
    if (days < 0) return 2;
    if (days <= 3) level = 1;
  }
  return level;
}
void updateAlertLed() {
  if (snoozeMode) {
    digitalWrite(ALERT_LED, LOW);
    return;
  }
  uint8_t level = highestAlertLevel();
  if (level == 0) {
    digitalWrite(ALERT_LED, LOW);
    return;
  }
  unsigned long interval = level == 2 ? FAST_BLINK_MS : SLOW_BLINK_MS;
  digitalWrite(ALERT_LED, (millis() / interval) % 2 ? HIGH : LOW);
}
void drawBattery() {
  int percent = batteryPercent();
  display.drawRect(103, 2, 19, 8, SSD1306_WHITE);
  display.fillRect(122, 4, 2, 4, SSD1306_WHITE);
  int width = map(percent, 0, 100, 0, 15);
  if (width > 0) display.fillRect(105, 4, width, 4, SSD1306_WHITE);
}
void drawExpiredWarning(uint8_t x, uint8_t y) {
  display.fillTriangle(x, y + 13, x + 7, y, x + 14, y + 13, SSD1306_WHITE);
  display.setTextColor(SSD1306_BLACK);
  display.setTextSize(1);
  display.setCursor(x + 4, y + 4);
  display.print('!');
  display.setTextColor(SSD1306_WHITE);
}
void printBoldProduct(const String& product) {
  String visibleName = product.substring(0, 10);
  const int characterWidth = 12;  // Default Adafruit font at text size 2.
  int x = max(0, (128 - static_cast<int>(visibleName.length()) * characterWidth) / 2);
  display.setTextSize(2);
  display.setCursor(x, 14);
  display.print(visibleName);
  display.setCursor(x + 1, 14);  // A second pass makes the built-in font bold.
  display.print(visibleName);
}
void showCarboxSplash() {
  for (uint8_t frame = 0; frame < 10; frame++) {
    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.setTextSize(2);
    display.setCursor(28, 19);
    display.print("CARBOX");
    display.drawRoundRect(18, 47, 92, 7, 3, SSD1306_WHITE);
    display.fillRoundRect(20, 49, (frame + 1) * 8, 3, 1, SSD1306_WHITE);
    display.display();
    delay(200);
  }
}
void enterSnoozeMode() {
  snoozeMode = true;
  digitalWrite(ALERT_LED, LOW);
  display.clearDisplay();
  display.display();
  display.ssd1306_command(SSD1306_DISPLAYOFF);
}
void wakeFromSnooze() {
  snoozeMode = false;
  lastInteraction = millis();
  display.ssd1306_command(SSD1306_DISPLAYON);
}
void updateSnoozeMode() {
  if (!snoozeMode && millis() - lastInteraction >= SNOOZE_AFTER_MS) {
    enterSnoozeMode();
  }
}
void handleIrSensor() {
  bool objectDetected = digitalRead(IR_SENSOR) == IR_DETECTED_STATE;
  if (!objectDetected) return;
  if (snoozeMode) wakeFromSnooze();
  lastInteraction = millis();
}
void drawDisplay() {
  if (snoozeMode) return;
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  drawBattery();
  display.setTextSize(1);
  display.setCursor(0, 2);
  display.print("Hold D6 delete");
  if (itemCount == 0) {
    display.setCursor(8, 26);
    display.print(lastSyncFailed ? "Product sync failed" : "No products found");
    display.setCursor(8, 42);
    display.print(lastSyncFailed ? lastSyncStatus.substring(0, 20) : "Checking every 10 sec");
    display.display();
    return;
  }
  const FridgeItem& item = items[selectedItem];
  int days = daysUntilExpiry(item);
  bool blinkVisible = (millis() / (days < 0 ? FAST_BLINK_MS : SLOW_BLINK_MS)) % 2;
  printBoldProduct(item.product);
  display.setTextSize(1);
  if (days < 0) {
    if (blinkVisible) {
      drawExpiredWarning(8, 37);
      display.setCursor(30, 40);
      display.print("EXPIRED");
    }
    display.setCursor(30, 53);
    display.print("Remove product");
  } else if (days <= 3) {
    display.setCursor(8, 42);
    display.print("Use soon: ");
    display.print(days == 0 ? "today" : String(days) + " day(s)");
    display.setCursor(8, 54);
    display.print("Expiry: ");
    display.print(item.expiryDate);
  } else {
    display.setCursor(8, 46);
    display.print("Expiry: ");
    display.print(item.expiryDate);
  }
  display.display();
}
bool fetchProducts() {
  if (WiFi.status() != WL_CONNECTED && !connectWiFi()) {
    lastSyncFailed = true;
    lastSyncStatus = "Wi-Fi not connected";
    return false;
  }
  WiFiClient client;
  HTTPClient http;
  http.setTimeout(8000);
  String endpoint = deviceConfig.apiEndpoint;
  if (!http.begin(client, endpoint)) {
    lastSyncFailed = true;
    lastSyncStatus = "Invalid API address";
    return false;
  }
  int httpCode = http.GET();
  if (httpCode != HTTP_CODE_OK) {
    http.end();
    lastSyncFailed = true;
    lastSyncStatus = "HTTP error " + String(httpCode);
    return false;
  }
  DynamicJsonDocument json(4096);
  DeserializationError error = deserializeJson(json, http.getStream());
  http.end();
  if (error) {
    lastSyncFailed = true;
    lastSyncStatus = "Invalid API response";
    return false;
  }
  JsonArray incoming = json["items"].as<JsonArray>();
  if (incoming.isNull()) {
    lastSyncFailed = true;
    lastSyncStatus = "No items in response";
    return false;
  }
  itemCount = min((size_t)MAX_ITEMS, incoming.size());
  for (uint8_t i = 0; i < itemCount; i++) {
    items[i].id = incoming[i]["id"] | "";
    items[i].product = incoming[i]["product"] | "Unnamed product";
    items[i].expiryDate = incoming[i]["expiryDate"] | "";
    items[i].quantity = incoming[i]["quantity"] | 1;
  }
  sortItemsByExpiryDate();
  if (selectedItem >= itemCount) selectedItem = 0;
  lastSyncFailed = false;
  lastSyncStatus = "Synced";
  return true;
}
void handleNavigationButtons() {
  bool upState = digitalRead(UP_BUTTON);
  bool downState = digitalRead(DOWN_BUTTON);
  if (snoozeMode) {
    if (upState == LOW || downState == LOW) wakeFromSnooze();
    lastUpButtonState = upState;
    lastDownButtonState = downState;
    downButtonPressedAt = 0;
    downLongPressHandled = false;
    return;
  }
  // D4 + D6 together always takes priority over menu navigation.
  // It opens setup mode without erasing the old settings until new settings are saved.
  if (upState == LOW && downState == LOW) {
    lastInteraction = millis();
    startConfigPortal();
  }
  if (lastUpButtonState == HIGH && upState == LOW && millis() - lastUpButtonChange > 180) {
    if (itemCount) selectedItem = (selectedItem + itemCount - 1) % itemCount;
    lastUpButtonChange = millis();
    lastInteraction = millis();
  }
  lastUpButtonState = upState;

  if (lastDownButtonState == HIGH && downState == LOW && millis() - lastDownButtonChange > 180) {
    downButtonPressedAt = millis();
    downLongPressHandled = false;
    lastDownButtonChange = millis();
    lastInteraction = millis();
  }
  if (downState == LOW && downButtonPressedAt > 0 && !downLongPressHandled &&
      millis() - downButtonPressedAt >= DELETE_HOLD_MS) {
    deleteSelectedItem();
    downLongPressHandled = true;
    lastInteraction = millis();
  }
  if (lastDownButtonState == LOW && downState == HIGH && millis() - lastDownButtonChange > 180) {
    if (!downLongPressHandled && itemCount) selectedItem = (selectedItem + 1) % itemCount;
    downButtonPressedAt = 0;
    downLongPressHandled = false;
    lastDownButtonChange = millis();
    lastInteraction = millis();
  }
  lastDownButtonState = downState;
}
void handleWiFiSetupButton() {
  bool state = digitalRead(WIFI_SETUP_BUTTON);
  if (snoozeMode) {
    if (state == LOW) wakeFromSnooze();
    lastSetupButtonState = state;
    return;
  }
  if (lastSetupButtonState == HIGH && state == LOW && millis() - lastSetupButtonChange > 180) {
    lastSetupButtonChange = millis();
    lastInteraction = millis();
    startConfigPortal();
  }
  lastSetupButtonState = state;
}
void setup() {
  pinMode(ALERT_LED, OUTPUT);
  pinMode(UP_BUTTON, INPUT_PULLUP);
  pinMode(DOWN_BUTTON, INPUT_PULLUP);
  pinMode(WIFI_SETUP_BUTTON, INPUT_PULLUP);
  pinMode(IR_SENSOR, INPUT);
  Wire.begin(OLED_SDA, OLED_SCL);
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  showCarboxSplash();
  loadConfig();
  if (!hasSavedConfig() || !connectWiFi()) startConfigPortal();
  configTime(0, 0, "pool.ntp.org", "time.nist.gov");
  setenv("TZ", "IST-5:30", 1); // Change to your local POSIX time-zone rule.
  tzset();
  while (time(nullptr) < 100000) delay(200);
  fetchProducts();
  lastFetch = millis();
  lastInteraction = millis();
}
void loop() {
  handleNavigationButtons();
  handleWiFiSetupButton();
  handleIrSensor();
  updateSnoozeMode();
  if (millis() - lastFetch >= FETCH_INTERVAL_MS) {
    fetchProducts();
    lastFetch = millis();
  }
  updateAlertLed();
  drawDisplay();
  delay(35);
}


