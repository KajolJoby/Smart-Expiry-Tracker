/*
  Smart Expiry Tracker - ESP8266 / NodeMCU

  Arduino Library Manager libraries:
    - Adafruit GFX Library
    - Adafruit SSD1306
    - ArduinoJson (version 6)

  Wiring (NodeMCU / ESP-12E):
    OLED SSD1306 I2C: SDA -> D2, SCL -> D1, VCC -> 3V3, GND -> GND
    LED: anode -> D5 through a 220 ohm resistor; cathode -> GND
    Up button: D4 -> button -> GND    (uses INPUT_PULLUP)
    Down button: D6 -> button -> GND  (uses INPUT_PULLUP)
    Wi-Fi reset: press Up and Down together
    Wi-Fi setup button: D7 -> button -> GND (uses INPUT_PULLUP)
    Battery: Li-ion + -> 330k resistor -> A0 -> 100k resistor -> GND
             This divider limits a 4.2V Li-ion cell to about 0.98V at bare ESP8266 A0.

  The endpoint must return JSON in this form:
  {"items":[{"product":"Milk","expiryDate":"2026-07-20","quantity":1}]}

  This sketch reads the LAN API provided by this project while Vite is running:
  http://10.160.1.197:5175/api

  The ESP8266 and the computer running Vite must be on the same Wi-Fi network.
  Do NOT expose this development API to the public internet.
*/

#include <ESP8266WiFi.h>
#include <ESP8266HTTPClient.h>
#include <ESP8266WebServer.h>
#include <DNSServer.h>
#include <EEPROM.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <ArduinoJson.h>
#include <time.h>

// LAN API. Change this only if the computer's local IP address changes.
const char* API_BASE_ENDPOINT = "http://10.160.1.197:5175/api";

constexpr char CONFIG_AP_NAME[] = "SmartFridge-Setup";
constexpr byte DNS_PORT = 53;
constexpr uint32_t CONFIG_MAGIC = 0x53465431; // "SFT1"

struct DeviceConfig {
  uint32_t magic;
  char wifiSsid[33];
  char wifiPassword[65];
  char networkId[33];
};

DeviceConfig deviceConfig = {};
ESP8266WebServer configServer(80);
DNSServer dnsServer;

// ESP8266 pins
constexpr uint8_t OLED_SDA = D2;
constexpr uint8_t OLED_SCL = D1;
constexpr uint8_t ALERT_LED = D5;
constexpr uint8_t UP_BUTTON = D4;
constexpr uint8_t DOWN_BUTTON = D6;
constexpr uint8_t WIFI_SETUP_BUTTON = D7;

// Battery calibration: bare ESP8266 A0 is 0-1.0V and the listed divider ratio is 4.3.
constexpr float ADC_REFERENCE_VOLTAGE = 1.0F;
constexpr float BATTERY_DIVIDER_RATIO = 4.30F;
constexpr float BATTERY_EMPTY_VOLTAGE = 3.20F;
constexpr float BATTERY_FULL_VOLTAGE = 4.20F;

constexpr unsigned long FETCH_INTERVAL_MS = 10000;
constexpr unsigned long FAST_BLINK_MS = 250;
constexpr unsigned long SLOW_BLINK_MS = 900;
constexpr uint8_t MAX_ITEMS = 12;

Adafruit_SSD1306 display(128, 64, &Wire, -1);

struct FridgeItem {
  String product;
  String expiryDate;  // YYYY-MM-DD
  int quantity;
};

FridgeItem items[MAX_ITEMS];
uint8_t itemCount = 0;
uint8_t selectedItem = 0;
unsigned long lastFetch = 0;
unsigned long lastUpButtonChange = 0;
bool lastUpButtonState = HIGH;
unsigned long lastDownButtonChange = 0;
bool lastDownButtonState = HIGH;
unsigned long lastSetupButtonChange = 0;
bool lastSetupButtonState = HIGH;

bool hasSavedConfig() {
  return deviceConfig.magic == CONFIG_MAGIC && deviceConfig.wifiSsid[0] != '\0' &&
         deviceConfig.networkId[0] != '\0';
}

void loadConfig() {
  EEPROM.begin(sizeof(DeviceConfig));
  EEPROM.get(0, deviceConfig);
}

void saveConfig(const String& ssid, const String& password, const String& networkId) {
  memset(&deviceConfig, 0, sizeof(deviceConfig));
  deviceConfig.magic = CONFIG_MAGIC;
  ssid.toCharArray(deviceConfig.wifiSsid, sizeof(deviceConfig.wifiSsid));
  password.toCharArray(deviceConfig.wifiPassword, sizeof(deviceConfig.wifiPassword));
  networkId.toCharArray(deviceConfig.networkId, sizeof(deviceConfig.networkId));
  EEPROM.put(0, deviceConfig);
  EEPROM.commit();
}

void showPortalPage() {
  const String page = R"rawliteral(
<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Smart Fridge Wi-Fi Setup</title><style>body{font-family:Arial;margin:2rem;max-width:420px}label,input,button{display:block;width:100%;box-sizing:border-box;margin-top:.6rem}input,button{padding:.75rem;font-size:1rem}button{background:#1677ff;border:0;color:#fff;border-radius:6px}</style>
</head><body><h2>Smart Fridge setup</h2><p>Enter the Wi-Fi network the fridge should use and a unique network/device ID.</p>
<form action="/save" method="post"><label>Wi-Fi name (SSID)<input name="ssid" maxlength="32" required></label>
<label>Wi-Fi password<input name="password" type="password" maxlength="64"></label>
<label>Network / device ID<input name="networkId" maxlength="32" required placeholder="e.g. kitchen-fridge"></label>
<button type="submit">Save and connect</button></form></body></html>)rawliteral";
  configServer.send(200, "text/html", page);
}

void startConfigPortal() {
  WiFi.disconnect();
  delay(100);
  WiFi.mode(WIFI_AP);
  WiFi.softAP(CONFIG_AP_NAME); // Open network: anyone nearby can complete setup.
  dnsServer.start(DNS_PORT, "*", WiFi.softAPIP());

  configServer.on("/save", HTTP_POST, []() {
    String ssid = configServer.arg("ssid");
    String password = configServer.arg("password");
    String networkId = configServer.arg("networkId");
    if (ssid.length() == 0 || networkId.length() == 0) {
      configServer.send(400, "text/plain", "Wi-Fi name and network ID are required.");
      return;
    }
    saveConfig(ssid, password, networkId);
    configServer.send(200, "text/html", "<h2>Saved</h2><p>The Smart Fridge is restarting and connecting to Wi-Fi.</p>");
    delay(1200);
    ESP.restart();
  });
  configServer.onNotFound(showPortalPage); // Captive-portal probes and all URLs show setup.
  configServer.begin();

  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 14);
  display.print("Wi-Fi setup mode");
  display.setCursor(0, 30);
  display.print("Connect to:");
  display.setCursor(0, 42);
  display.print(CONFIG_AP_NAME);
  display.setCursor(0, 54);
  display.print("Then open any website");
  display.display();

  while (true) {
    dnsServer.processNextRequest();
    configServer.handleClient();
    delay(2);
  }
}

bool connectWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.begin(deviceConfig.wifiSsid, deviceConfig.wifiPassword);
  unsigned long startedAt = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - startedAt < 20000) {
    delay(300);
  }
  return WiFi.status() == WL_CONNECTED;
}

String urlEncode(const String& text) {
  const char* hex = "0123456789ABCDEF";
  String encoded;
  for (size_t i = 0; i < text.length(); i++) {
    char c = text[i];
    if (isalnum(c) || c == '-' || c == '_' || c == '.') encoded += c;
    else {
      encoded += '%';
      encoded += hex[(c >> 4) & 0x0F];
      encoded += hex[c & 0x0F];
    }
  }
  return encoded;
}

int batteryPercent() {
  float adcVoltage = analogRead(A0) * (ADC_REFERENCE_VOLTAGE / 1023.0F);
  float batteryVoltage = adcVoltage * BATTERY_DIVIDER_RATIO;
  int percent = round((batteryVoltage - BATTERY_EMPTY_VOLTAGE) * 100.0F /
                      (BATTERY_FULL_VOLTAGE - BATTERY_EMPTY_VOLTAGE));
  return constrain(percent, 0, 100);
}

time_t expiryTime(const String& dateText) {
  int year, month, day;
  if (sscanf(dateText.c_str(), "%d-%d-%d", &year, &month, &day) != 3) return 0;
  tm expiry = {};
  expiry.tm_year = year - 1900;
  expiry.tm_mon = month - 1;
  expiry.tm_mday = day;
  expiry.tm_hour = 12;  // Avoid daylight-saving/date-boundary problems.
  return mktime(&expiry);
}

int daysUntilExpiry(const FridgeItem& item) {
  time_t expiry = expiryTime(item.expiryDate);
  if (expiry == 0) return 9999;
  time_t now = time(nullptr);
  return floor(difftime(expiry, now) / 86400.0F);
}

// 2 = expired, 1 = expiring within three days, 0 = normal
uint8_t highestAlertLevel() {
  uint8_t level = 0;
  for (uint8_t i = 0; i < itemCount; i++) {
    int days = daysUntilExpiry(items[i]);
    if (days < 0) return 2;
    if (days <= 3) level = 1;
  }
  return level;
}

void updateAlertLed() {
  uint8_t level = highestAlertLevel();
  if (level == 0) {
    digitalWrite(ALERT_LED, LOW);
    return;
  }
  unsigned long interval = level == 2 ? FAST_BLINK_MS : SLOW_BLINK_MS;
  digitalWrite(ALERT_LED, (millis() / interval) % 2 ? HIGH : LOW);
}

void drawBattery() {
  int percent = batteryPercent();
  display.drawRect(103, 2, 19, 8, SSD1306_WHITE);
  display.fillRect(122, 4, 2, 4, SSD1306_WHITE);
  int width = map(percent, 0, 100, 0, 15);
  if (width > 0) display.fillRect(105, 4, width, 4, SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(81, 2);
  display.print(percent);
  display.print('%');
}

void drawDisplay() {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(0, 2);
  display.print("SMART FRIDGE");
  drawBattery();
  display.drawLine(0, 12, 127, 12, SSD1306_WHITE);

  if (itemCount == 0) {
    display.setCursor(8, 29);
    display.print("No products found");
    display.setCursor(8, 43);
    display.print("Checking every 10 sec");
    display.display();
    return;
  }

  const FridgeItem& item = items[selectedItem];
  int days = daysUntilExpiry(item);
  bool blinkVisible = highestAlertLevel() == 0 ||
                      (millis() / (days < 0 ? FAST_BLINK_MS : SLOW_BLINK_MS)) % 2;

  display.setTextSize(1);
  display.setCursor(2, 17);
  display.print('>');              // Arrow shows the selected menu entry.
  display.setCursor(12, 17);
  display.print(selectedItem + 1);
  display.print('/');
  display.print(itemCount);
  display.setCursor(45, 17);
  display.print(item.product.substring(0, 13));

  display.setTextSize(2);
  display.setCursor(7, 31);
  display.print(item.quantity);
  display.setTextSize(1);
  display.print(" item(s)");

  display.setCursor(7, 49);
  if (days < 0 && blinkVisible) {
    display.print("EXPIRED - remove it!");
  } else if (days <= 3 && blinkVisible) {
    display.print("Use soon: ");
    display.print(days == 0 ? "today" : String(days) + " day(s)");
  } else if (days > 3) {
    display.print("Expiry: ");
    display.print(item.expiryDate);
  }
  display.display();
}

bool fetchProducts() {
  if (WiFi.status() != WL_CONNECTED && !connectWiFi()) return false;

  WiFiClient client;
  HTTPClient http;
  http.setTimeout(8000);
  String endpoint = String(API_BASE_ENDPOINT) + "?networkId=" + urlEncode(deviceConfig.networkId);
  if (!http.begin(client, endpoint)) return false;
  int httpCode = http.GET();
  if (httpCode != HTTP_CODE_OK) {
    http.end();
    return false;
  }

  DynamicJsonDocument json(4096);
  DeserializationError error = deserializeJson(json, http.getStream());
  http.end();
  if (error) return false;

  JsonArray incoming = json["items"].as<JsonArray>();
  if (incoming.isNull()) return false;
  itemCount = min((size_t)MAX_ITEMS, incoming.size());
  for (uint8_t i = 0; i < itemCount; i++) {
    items[i].product = incoming[i]["product"] | "Unnamed product";
    items[i].expiryDate = incoming[i]["expiryDate"] | "";
    items[i].quantity = incoming[i]["quantity"] | 1;
  }
  if (selectedItem >= itemCount) selectedItem = 0;
  return true;
}

void handleNavigationButtons() {
  bool upState = digitalRead(UP_BUTTON);
  bool downState = digitalRead(DOWN_BUTTON);

  // D4 + D6 together always takes priority over menu navigation.
  // It opens setup mode without erasing the old settings until new settings are saved.
  if (upState == LOW && downState == LOW) {
    startConfigPortal();
  }

  if (lastUpButtonState == HIGH && upState == LOW && millis() - lastUpButtonChange > 180) {
    if (itemCount) selectedItem = (selectedItem + itemCount - 1) % itemCount;
    lastUpButtonChange = millis();
  }
  lastUpButtonState = upState;

  if (lastDownButtonState == HIGH && downState == LOW && millis() - lastDownButtonChange > 180) {
    if (itemCount) selectedItem = (selectedItem + 1) % itemCount;
    lastDownButtonChange = millis();
  }
  lastDownButtonState = downState;
}

void handleWiFiSetupButton() {
  bool state = digitalRead(WIFI_SETUP_BUTTON);
  if (lastSetupButtonState == HIGH && state == LOW && millis() - lastSetupButtonChange > 180) {
    lastSetupButtonChange = millis();
    startConfigPortal();
  }
  lastSetupButtonState = state;
}

void setup() {
  pinMode(ALERT_LED, OUTPUT);
  pinMode(UP_BUTTON, INPUT_PULLUP);
  pinMode(DOWN_BUTTON, INPUT_PULLUP);
  pinMode(WIFI_SETUP_BUTTON, INPUT_PULLUP);
  Wire.begin(OLED_SDA, OLED_SCL);
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(12, 28);
  display.print("Connecting WiFi...");
  display.display();

  loadConfig();
  if (!hasSavedConfig() || !connectWiFi()) startConfigPortal();
  configTime(0, 0, "pool.ntp.org", "time.nist.gov");
  setenv("TZ", "IST-5:30", 1); // Change to your local POSIX time-zone rule.
  tzset();
  while (time(nullptr) < 100000) delay(200);
  fetchProducts();
  lastFetch = millis();
}

void loop() {
  handleNavigationButtons();
  handleWiFiSetupButton();
  if (millis() - lastFetch >= FETCH_INTERVAL_MS) {
    fetchProducts();
    lastFetch = millis();
  }
  updateAlertLed();
  drawDisplay();
  delay(35);
}
